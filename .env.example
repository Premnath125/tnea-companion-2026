# ==============================================================================
# TNEA Companion 2026 - Supabase Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your Supabase project credentials.
# You can find these in your Supabase Project Dashboard -> Project Settings -> API.

# 1. Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# 2. Supabase Anonymous Public API Key (anon / public)
# DO NOT use the service_role key here. Only use the anon public key.
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
